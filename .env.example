# ==============================================================================
# ISMS RAG Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual values
# .env is gitignored and will not be committed to version control
# ==============================================================================

# ==============================================================================
# OpenAI API Configuration
# ==============================================================================

# Your OpenAI API key - Required for LLM and embeddings
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# Language Model (LLM) Settings
# ==============================================================================

# The OpenAI model to use for text generation
# Options: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# gpt-4 is recommended for better quality responses
LLM_MODEL=gpt-4

# Temperature controls randomness in responses (0.0 to 1.0)
# Lower values (0.1-0.3) = more focused and deterministic
# Higher values (0.7-1.0) = more creative and varied
# 0.2 is recommended for factual Q&A
LLM_TEMPERATURE=0.2

# Maximum number of tokens in the response
# Controls the length of generated answers
# 2000 tokens ≈ 1500 words
MAX_TOKENS=2000

# ==============================================================================
# Embedding Model Configuration
# ==============================================================================

# Model for generating text embeddings
# This multilingual model supports French and English well
# Alternative: sentence-transformers/all-MiniLM-L6-v2 (English only, faster)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# ==============================================================================
# Vector Database Configuration
# ==============================================================================

# Directory where ChromaDB will persist vector embeddings
# This directory will be created automatically
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Collection name for storing document embeddings
# Separate collections can be used for different document types
CHROMA_COLLECTION_NAME=isms_frameworks

# ==============================================================================
# Document Processing Settings
# ==============================================================================

# Size of text chunks for splitting documents (in characters)
# Larger chunks = more context, slower processing
# Smaller chunks = faster, more precise retrieval
CHUNK_SIZE=1000

# Number of overlapping characters between chunks
# Helps maintain context across chunk boundaries
CHUNK_OVERLAP=200

# ==============================================================================
# Language Configuration
# ==============================================================================

# Default language for responses
# Options: fr (French), en (English)
DEFAULT_LANGUAGE=fr

# Comma-separated list of supported languages
# Currently supports French and English
SUPPORTED_LANGUAGES=fr,en

# ==============================================================================
# Retrieval Configuration
# ==============================================================================

# Number of similar documents to retrieve for each query
# Higher values provide more context but may include irrelevant info
TOP_K_RESULTS=5

# Minimum similarity score (0.0 to 1.0) for retrieved documents
# Higher values = stricter matching, fewer but more relevant results
SIMILARITY_THRESHOLD=0.7

# ==============================================================================
# Application Settings
# ==============================================================================

# Application environment
# Options: development, staging, production
APP_ENV=development

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable debug mode (shows detailed error messages)
# Set to false in production
DEBUG=true
